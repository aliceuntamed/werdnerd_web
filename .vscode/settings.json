{
  "files.autoSave": "onFocusChange",
  "editor.wordWrap": "on",
  "vite.https": true,
  "editor.formatOnSave": true,
  "builder.serverUrl": "",
  "builder.command": "npm run dev",
  "builder.runDevServer": true,
  "builder.autoDetectDevServer": true,
  "builder.launchType": "desktop",
  "component-preview.devServerUrl": "http://localhost:5173",
  "editor.defaultFormatter": "openai.chatgpt",
  "search.exclude": {
    "**/*.code-search": false,
    "**/bower_components": false,
    "**/node_modules": false
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "colorize.colorized_colors": [
    "BROWSERS_COLORS",
    "HEXA",
    "RGB",
    "HSL",
    "OKLAB",
    "OKLCH"
  ],
  "auto-correct.dictionary": [

    {
      "languages": [
        "*"
      ],
      "words": {},
      "useLargeList": false
    },
    {
      "languages": [
        "javascript",
        "javascriptreact",
        "typescript",
        "typescriptreact"
      ],
      "words": {
        "cosnt": "const",
        "functoin": "function"
      }
    }
],
"chatgpt.followUpQueueMode": "steer",
"colorize.hide_current_line_decorations": false,
"colorize.include": [

    "**/*.css",
    "**/*.scss",
    "**/*.sass",
    "**/*.less",
    "**/*.styl",
    "**/*.html",
    "**/*.tsx",
    "**/*.ts",
    "**/*.jsx",
    "**/*.md"

]
}