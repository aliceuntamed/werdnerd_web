{
  "name": "werdnerd-web",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource/poppins": "^5.2.7",
    "@radix-ui/react-select": "^2.2.6",
    "@supabase/supabase-js": "^2.105.4",
    "@tailwindcss/vite": "^4.2.2",
    "clsx": "^2.1.1",
    "empirical": "^0.0.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.14.1",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "vscode-webhint": "^2.1.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "^4.1.2",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "exceljs": "^4.4.0",
    "globals": "^17.7.0",
    "playwright": "^1.59.1",
    "typescript": "^5.6.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run --browser.enabled=false --environment=node",
    "preview": "vite preview",
    "werds:enrich": "node scripts/enrich-werds-from-sources.mjs",
    "werds:enrich:write": "node scripts/enrich-werds-from-sources.mjs --write-workbook",
    "werds:dry-run": "node scripts/import-werds-from-excel.mjs",
    "werds:import": "node scripts/import-werds-from-excel.mjs --import --write-workbook"
  },
  "hintConfig": {
    "connector": {
      "name": "connectorName"
    },
    "formatters": [
      "formatterName"
    ],
    "parsers": [
      "parserName"
    ],
    "hints": {
      "hint1": "error",
      "hint2": "warning",
      "hint3": "off"
    },
    "hintsTimeout": 120000
  }
}
